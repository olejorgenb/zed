#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: $0 <tag> [main-ref]" >&2
    echo >&2
    echo "Prints the commit on main that a release shipped from — the right thing" >&2
    echo "to rebase a long-lived branch onto." >&2
    echo >&2
    echo "Zed cuts a release branch from main and then cherry-picks fixes onto it," >&2
    echo "so a release tag is never reachable from main. The branch point is, and" >&2
    echo "it is not just an arbitrary nearby commit: every vX.Y.0-pre tag is" >&2
    echo "identical to its merge-base with main except for one line in" >&2
    echo "crates/zed/RELEASE_CHANNEL. That merge-base is the source a preview build" >&2
    echo "shipped from." >&2
    echo >&2
    echo "Later tags on the same line (vX.Y.0, vX.Y.2, ...) share that merge-base;" >&2
    echo "the extra commits are fixes found after the cut. They are listed so you" >&2
    echo "can cherry-pick from main the ones you care about — the target itself" >&2
    echo "predates them." >&2
    echo >&2
    echo "main-ref defaults to the first of: main, upstream/main, origin/main" >&2
    echo >&2
    echo "PICKS_LIMIT (default 20) caps how many post-cut commits are listed." >&2
    exit 1
}

PICKS_LIMIT="${PICKS_LIMIT:-20}"
CHANNEL_FILE="crates/zed/RELEASE_CHANNEL"

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    usage
fi

TAG="$1"

if ! git rev-parse --verify --quiet "${TAG}^{commit}" >/dev/null; then
    echo "error: tag/ref '${TAG}' not found" >&2
    exit 1
fi

if [ "$#" -eq 2 ]; then
    MAIN_REF="$2"
    if ! git rev-parse --verify --quiet "${MAIN_REF}" >/dev/null; then
        echo "error: main ref '${MAIN_REF}' not found" >&2
        exit 1
    fi
else
    MAIN_REF=""
    for candidate in main upstream/main origin/main; do
        if git rev-parse --verify --quiet "${candidate}" >/dev/null; then
            MAIN_REF="${candidate}"
            break
        fi
    done
    if [ -z "${MAIN_REF}" ]; then
        echo "error: couldn't find a 'main' ref; pass one explicitly" >&2
        exit 1
    fi
fi

echo "Using main ref: ${MAIN_REF}" >&2

# `main` here is a pure mirror of upstream/main, so a stale mirror silently
# drags every answer backwards. Say so before it matters.
if [ "${MAIN_REF}" != "upstream/main" ] &&
    git rev-parse --verify --quiet upstream/main >/dev/null &&
    [ "$(git rev-parse "${MAIN_REF}")" != "$(git rev-parse upstream/main)" ] &&
    git merge-base --is-ancestor "${MAIN_REF}" upstream/main; then
    behind=$(git rev-list --count "${MAIN_REF}..upstream/main")
    echo "note: ${MAIN_REF} is ${behind} commit(s) behind upstream/main; fetch and update" >&2
    echo "      it, or pass upstream/main explicitly, or the answer will be too old" >&2
fi

if git merge-base --is-ancestor "${TAG}" "${MAIN_REF}"; then
    echo "note: ${TAG} is already an ancestor of ${MAIN_REF}" >&2
    git rev-parse "${TAG}"
    exit 0
fi

MERGE_BASE=$(git merge-base "${TAG}" "${MAIN_REF}")

# The shipped-point guard. `<line>.0-pre` is the tag cut at the branch point, so
# it should differ from the merge-base only by the release-channel marker. If it
# ever differs by more, upstream changed how releases are cut and the premise of
# this script needs re-checking — hence a warning rather than a silent answer.
PRE_TAG=""
if [[ "${TAG}" =~ ^(v[0-9]+\.[0-9]+)\. ]]; then
    candidate="${BASH_REMATCH[1]}.0-pre"
    if git rev-parse --verify --quiet "${candidate}^{commit}" >/dev/null; then
        PRE_TAG="${candidate}"
    fi
fi

if [ -n "${PRE_TAG}" ]; then
    changed=$(git diff --name-only "${MERGE_BASE}" "${PRE_TAG}")
    if [ "${changed}" = "${CHANNEL_FILE}" ]; then
        echo "shipped point: identical to ${PRE_TAG} except ${CHANNEL_FILE}" >&2
    elif [ -z "${changed}" ]; then
        echo "shipped point: identical to ${PRE_TAG}" >&2
    else
        echo "warning: ${MERGE_BASE:0:12} differs from ${PRE_TAG} by more than" >&2
        echo "         ${CHANNEL_FILE}:" >&2
        echo "${changed}" | sed 's/^/           /' >&2
        if [ "${MERGE_BASE}" = "$(git rev-parse "${MAIN_REF}")" ]; then
            echo "         This is the tip of ${MAIN_REF}, which means ${MAIN_REF} is behind" >&2
            echo "         the branch point: fetch and update it, then re-run." >&2
        else
            echo "         The release-cut convention this script relies on may have" >&2
            echo "         changed; verify before rebasing onto this commit." >&2
        fi
    fi
else
    echo "note: no <line>.0-pre tag found for ${TAG}; skipping the shipped-point check" >&2
fi

echo >&2
echo "$(git log -1 --format='%h %ad %s' --date=short "${MERGE_BASE}")" >&2

# Everything on the tag but not on main: the fixes found after the cut. The
# target predates all of them, so this doubles as the list of known defects in
# the baseline you are about to rebase onto.
mapfile -t PICKS < <(git log --format='%h  %s' "${MERGE_BASE}..${TAG}")
if [ "${#PICKS[@]}" -gt 0 ]; then
    echo >&2
    echo "${#PICKS[@]} commit(s) on ${TAG} after the cut (known fixes this target lacks):" >&2
    shown=0
    for line in "${PICKS[@]}"; do
        if [ "${shown}" -ge "${PICKS_LIMIT}" ]; then
            echo "  ... and $(( ${#PICKS[@]} - shown )) more (re-run with PICKS_LIMIT=<n>)" >&2
            break
        fi
        echo "  ${line}" >&2
        shown=$(( shown + 1 ))
    done
fi

echo "${MERGE_BASE}"
