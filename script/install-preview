#!/usr/bin/env bash

# Build this fork and install it as the system `zed`.
#
# The build is pinned to the "preview" release channel, which is an unused
# upstream slot borrowed on purpose: the channel scopes the sqlite database
# (~/.local/share/zed/db/0-<channel>), so this install keeps its workspace
# state separate from the "dev" channel that a plain `cargo run` uses.
# Settings, keymap and extensions are shared regardless — paths.rs has no
# channel logic. See README-fork.md.
#
# The channel is set through $ZED_RELEASE_CHANNEL rather than by editing
# crates/zed/RELEASE_CHANNEL, so this leaves no diff against upstream.
#
# Unlike script/bundle-linux this skips remote_server, the bundled libs, symbol
# stripping and license generation: none of them matter for a local install.
# Consequences: no SSH remote projects, and the in-app licenses view is empty.
#
# Every build is kept in $ZED_VERSIONS_DIR under a timestamp+commit id, and the
# install is just a hardlink out of that store, so rolling back to an earlier
# build costs nothing and needs no rebuild:
#
#     script/install-preview --list
#     script/install-preview --use 20260831-142455-cb8d58aa85

set -euo pipefail

cd "$(dirname "$0")/.."

CHANNEL="preview"
APP_ID="dev.zed.Zed-Preview"
APP_NAME="${ZED_APP_NAME:-Zed Preview}"
APP_DIR="${ZED_APP_DIR:-$HOME/.local/zed-ole.app}"
BIN_LINK="$HOME/.local/bin/zed"
target_dir="${CARGO_TARGET_DIR:-target}"

VERSIONS_DIR="${ZED_VERSIONS_DIR:-$HOME/.local/zed-ole-versions}"
# Each version is ~2G of unstripped binaries, but only one copy of the active
# one exists (the install hardlinks it), so this is N × 2G of disk.
KEEP_VERSIONS="${ZED_KEEP_VERSIONS:-5}"
# Which version $APP_DIR currently holds; the store is otherwise anonymous.
ACTIVE_FILE="$APP_DIR/VERSION"

usage() {
    cat <<EOF
usage: script/install-preview [--list | --use <version> | --help]

  (no arguments)   build the working tree, store it as a new version and install it
  --list           list stored versions, newest first
  --use <version>  install an already-stored version (id, unique id prefix, or "previous")

environment: ZED_VERSIONS_DIR=$VERSIONS_DIR, ZED_KEEP_VERSIONS=$KEEP_VERSIONS
EOF
}

active_version() {
    cat "$ACTIVE_FILE" 2>/dev/null || true
}

# Newest first. The id starts with a timestamp, so a reverse lexical sort is a
# reverse chronological one.
stored_versions() {
    [ -d "$VERSIONS_DIR" ] || return 0
    find "$VERSIONS_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort -r
}

list_versions() {
    local active
    active="$(active_version)"
    local found=0
    while read -r id; do
        [ -n "$id" ] || continue
        found=1
        local marker="  "
        [ "$id" = "$active" ] && marker="* "
        local description=""
        if [ -f "$VERSIONS_DIR/$id/manifest" ]; then
            description="$(sed -n 's/^description: //p' "$VERSIONS_DIR/$id/manifest")"
        fi
        printf '%s%s  %s\n' "$marker" "$id" "$description"
    done < <(stored_versions)
    if [ "$found" = 0 ]; then
        echo "no versions stored in $VERSIONS_DIR yet"
    fi
}

resolve_version() {
    local wanted="$1"
    if [ "$wanted" = "previous" ]; then
        # The newest stored version that is not the installed one.
        local active
        active="$(active_version)"
        stored_versions | grep -v -x -F "${active:-$$-no-active}" | head -1
        return
    fi
    if [ -d "$VERSIONS_DIR/$wanted" ]; then
        echo "$wanted"
        return
    fi
    local matches
    matches="$(stored_versions | grep "^$wanted" || true)"
    if [ "$(echo "$matches" | grep -c .)" = 1 ]; then
        echo "$matches"
        return
    fi
    if [ -n "$matches" ]; then
        echo "error: '$wanted' matches several versions:" >&2
        echo "$matches" >&2
    else
        echo "error: no stored version matches '$wanted'" >&2
    fi
    return 1
}

store_build() {
    local commit dirty id
    commit="$(git rev-parse --short HEAD)"
    dirty=""
    git diff --quiet HEAD 2>/dev/null || dirty="-dirty"
    id="$(date +%Y%m%d-%H%M%S)-$commit$dirty"

    local version_dir="$VERSIONS_DIR/$id"
    mkdir -p "$version_dir"
    cp "$target_dir/release/zed" "$version_dir/zed-editor"
    cp "$target_dir/release/cli" "$version_dir/zed"
    chmod +x "$version_dir/zed-editor" "$version_dir/zed"
    cat > "$version_dir/manifest" <<EOF
id: $id
commit: $(git rev-parse HEAD)
branch: $(git rev-parse --abbrev-ref HEAD)
built: $(date --iso-8601=seconds)
worktree: $([ -n "$dirty" ] && echo "modified" || echo "clean")
description: $(git rev-parse --abbrev-ref HEAD)${dirty:+ (dirty)} — $(git log -1 --format=%s)
EOF
    echo "$id"
}

# Rename rather than copy: the destination may be a running Zed, and writing
# over a busy executable fails with ETXTBSY while replacing the directory
# entry does not. Hardlink where possible so a stored version and the install
# share one 2G inode; a cross-filesystem $ZED_VERSIONS_DIR falls back to a copy.
install_binary() {
    local source="$1" destination="$2"
    mkdir -p "$(dirname "$destination")"
    ln -f "$source" "$destination.new" 2>/dev/null || cp "$source" "$destination.new"
    chmod +x "$destination.new"
    mv -f "$destination.new" "$destination"
}

install_version() {
    local id="$1"
    echo "==> Installing $id to $APP_DIR"
    install_binary "$VERSIONS_DIR/$id/zed-editor" "$APP_DIR/libexec/zed-editor"
    install_binary "$VERSIONS_DIR/$id/zed" "$APP_DIR/bin/zed"
    echo "$id" > "$ACTIVE_FILE"
}

# Keep the newest $KEEP_VERSIONS, and never drop the installed one even if it
# has aged out (which it has, after a few rollbacks).
prune_versions() {
    local active
    active="$(active_version)"
    local index=0
    while read -r id; do
        [ -n "$id" ] || continue
        index=$((index + 1))
        if [ "$index" -le "$KEEP_VERSIONS" ] || [ "$id" = "$active" ]; then
            continue
        fi
        echo "    pruning $id"
        rm -rf "${VERSIONS_DIR:?}/$id"
    done < <(stored_versions)
}

case "${1:-}" in
    --help | -h)
        usage
        exit 0
        ;;
    --list)
        list_versions
        exit 0
        ;;
    --use)
        if [ $# -lt 2 ]; then
            usage >&2
            exit 1
        fi
        version="$(resolve_version "$2")"
        [ -n "$version" ] || { echo "error: no version to roll back to" >&2; exit 1; }
        ;;
    "")
        # Capped by default: a full release build at this machine's natural job
        # count saturates it for the duration. Raise or lower with CARGO_BUILD_JOBS=N.
        export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-6}"

        echo "==> Building ($CHANNEL channel, release, $CARGO_BUILD_JOBS jobs)"
        ZED_RELEASE_CHANNEL="$CHANNEL" cargo build --release --package zed --package cli

        echo "==> Storing build in $VERSIONS_DIR"
        version="$(store_build)"
        ;;
    *)
        usage >&2
        exit 1
        ;;
esac

install_version "$version"
prune_versions

mkdir -p "$(dirname "$BIN_LINK")"
previous_target="$(readlink "$BIN_LINK" || true)"
ln -sfn "$APP_DIR/bin/zed" "$BIN_LINK"
if [ -n "$previous_target" ] && [ "$previous_target" != "$APP_DIR/bin/zed" ]; then
    echo "    $BIN_LINK was -> $previous_target"
fi

# This script takes over the `zed` name, which otherwise leaves the upstream
# install reachable only by full path.
STABLE_APP_DIR="${ZED_STABLE_APP_DIR:-$HOME/.local/zed.app}"
if [ -x "$STABLE_APP_DIR/bin/zed" ]; then
    ln -sfn "$STABLE_APP_DIR/bin/zed" "$HOME/.local/bin/zed-stable"
else
    echo "    note: no stock Zed at $STABLE_APP_DIR, skipping zed-stable"
fi

icon_dir="$APP_DIR/share/icons/hicolor"
mkdir -p "$icon_dir/512x512/apps" "$icon_dir/1024x1024/apps"
cp "crates/zed/resources/app-icon-$CHANNEL.png" "$icon_dir/512x512/apps/zed.png"
cp "crates/zed/resources/app-icon-$CHANNEL@2x.png" "$icon_dir/1024x1024/apps/zed.png"

desktop_file="$HOME/.local/share/applications/$APP_ID.desktop"
if command -v envsubst >/dev/null 2>&1; then
    mkdir -p "$(dirname "$desktop_file")"
    APP_NAME="$APP_NAME" \
    APP_CLI="$APP_DIR/bin/zed" \
    APP_ICON="$icon_dir/512x512/apps/zed.png" \
    APP_ARGS="%U" \
    DO_STARTUP_NOTIFY="true" \
        envsubst < "crates/zed/resources/zed.desktop.in" > "$desktop_file"
    chmod +x "$desktop_file"
else
    echo "    warning: envsubst not found, skipping $desktop_file"
fi

# Route OS-level zed:// links to this install. Installing an additional .desktop
# file that declares x-scheme-handler/zed does NOT change the default handler, so
# without this the user's mimeapps.list keeps pointing zed:// links at stock Zed.
# (register_url_scheme is a no-op on Linux; the desktop mime DB is the only path.)
if [ -f "$desktop_file" ]; then
    if command -v xdg-mime >/dev/null 2>&1; then
        xdg-mime default "$APP_ID.desktop" x-scheme-handler/zed
        echo "    registered $APP_ID.desktop as default handler for zed:// links"
    elif command -v xdg-settings >/dev/null 2>&1; then
        xdg-settings set default-url-scheme-handler zed "$APP_ID.desktop"
        echo "    registered $APP_ID.desktop as default handler for zed:// links"
    else
        echo "    warning: neither xdg-mime nor xdg-settings found; zed:// links stay on stock Zed"
        echo "    run: xdg-mime default $APP_ID.desktop x-scheme-handler/zed"
    fi
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database "$(dirname "$desktop_file")" || true
    fi
fi

settings_file="${XDG_CONFIG_HOME:-$HOME/.config}/zed/settings.json"
if ! grep -qE '"auto_update"[[:space:]]*:[[:space:]]*false' "$settings_file" 2>/dev/null; then
    echo
    echo "!!  \"auto_update\" is not disabled in $settings_file"
    echo "!!  The $CHANNEL channel polls for updates, so upstream Zed will"
    echo "!!  eventually overwrite this build. Add: \"auto_update\": false"
fi

case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) echo "    note: $HOME/.local/bin is not on your PATH" ;;
esac

echo
# Via the CLI rather than the editor binary: only the CLI accepts --version, and
# it resolves ../libexec/zed-editor the same way a real launch does.
echo "Installed: $("$APP_DIR/bin/zed" --version || echo "(could not query version)") [$version]"
sed -n 's/^description: /           /p' "$VERSIONS_DIR/$version/manifest" 2>/dev/null || true
echo "Wayland app id is now $APP_ID (window rules keyed on the old id need updating)."
echo "To roll back: script/install-preview --list, then --use <version> (or --use previous)."
echo "To go back to stock Zed: ln -sfn ~/.local/zed.app/bin/zed $BIN_LINK"
echo "                       and, for zed:// links: xdg-mime default dev.zed.Zed.desktop x-scheme-handler/zed"
